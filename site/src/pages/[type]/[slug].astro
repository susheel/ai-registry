---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import CertificationBadge from "../../components/CertificationBadge.astro";
import SafetyBadges from "../../components/SafetyBadges.astro";
import InstallTabs from "../../components/InstallTabs.astro";
import CopyButton from "../../components/CopyButton.astro";
import Icon from "../../components/Icon.astro";
import EntryActions from "../../components/EntryActions.astro";
import { COLLECTION_KEYS, TYPE_META, type CollectionKey } from "../../lib/registry-types.js";
import { categoryLabel, harnessLabel } from "../../lib/vocab.js";
import { withBase } from "../../lib/url.js";
import { deriveAllInstallSnippets, type InstallableServer } from "../../../../scripts/install-snippets.js";
import { renderMarkdown, markdownToPlainText } from "../../../../scripts/lib/markdown.js";
import { deriveEntryActions } from "../../../../scripts/lib/entry-actions.js";
import { deriveQualifiedId, normaliseSegment, readUpstream } from "../../../../scripts/lib/upstream.js";
import { SAFETY_DISPLAY, safetyLevelAnchor } from "../../lib/vocab.js";

export async function getStaticPaths() {
  const paths = [];
  for (const key of COLLECTION_KEYS) {
    const entries = await getCollection(key);
    for (const entry of entries) {
      paths.push({ params: { type: key, slug: entry.id }, props: { entry } });
    }
  }
  return paths;
}

interface Props {
  entry: CollectionEntry<CollectionKey>;
}

const { type } = Astro.params as { type: CollectionKey };
const { entry } = Astro.props;
const meta = TYPE_META[type];
const data = entry.data as Record<string, unknown>;

const CLIENT_LABELS: Record<string, string> = {
  "claude-desktop": "Claude Desktop",
  "claude-code": "Claude Code",
  cursor: "Cursor",
  vscode: "VS Code",
  windsurf: "Windsurf",
  kiro: "Kiro",
  opencode: "opencode",
};

// Provenance timestamps are recorded at date precision (midnight UTC);
// show them as a readable date, keeping the machine value on <time>.
function formatDate(value: unknown): { iso: string; label: string } {
  const date = value instanceof Date ? value : new Date(String(value));
  if (Number.isNaN(date.getTime())) return { iso: String(value), label: String(value) };
  const iso = date.toISOString();
  const label = date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
  return { iso, label };
}

const maintainers = (data.maintainers as Array<{ name: string; github: string; affiliation?: string }>) ?? [];
const safety = (data.safety_classification as Array<{ scheme: string; level: string; source: string }>) ?? [];
const record = (data.record as { created?: string; updated?: string; last_verified?: string; source_issue?: number }) ?? {};
const standards = (data.ga4gh_standards as string[] | undefined) ?? [];
const keywords = (data.keywords as string[] | undefined) ?? [];

let mcpPanels: { id: string; label: string; content: string; deeplink?: string; hint?: string }[] = [];
if (type === "mcp-servers" && data.server) {
  const server = data.server as { name?: string; packages?: unknown; remotes?: unknown };
  const snippets = deriveAllInstallSnippets({
    name: String(server.name ?? entry.id),
    packages: server.packages,
    remotes: server.remotes,
  } as unknown as InstallableServer);
  mcpPanels = snippets.map((s) => ({
    id: s.client,
    label: CLIENT_LABELS[s.client] ?? s.client,
    content: s.configJson,
    deeplink: s.deeplink,
    hint: `Add this to your ${CLIENT_LABELS[s.client] ?? s.client} MCP server configuration.`,
  }));
}

let pluginPanels: { id: string; label: string; content: string; hint?: string }[] = [];
if (type === "plugins") {
  const ga4gh = (data.ga4gh as { harnesses?: Array<{ harness: string; installCommand: string }> }) ?? {};
  pluginPanels = (ga4gh.harnesses ?? []).map((h) => ({ id: h.harness, label: harnessLabel(h.harness), content: h.installCommand, hint: `Run in ${harnessLabel(h.harness)}:` }));
}

// `description` is documented as Markdown and arrives via public
// submissions: rendered at build time through the allowlist renderer, which
// escapes any raw HTML and drops unsafe link protocols.
const descriptionHtml = renderMarkdown(String(data.description ?? ""));
const summaryText = markdownToPlainText(String(data.summary ?? ""));
// Upstream ownership and version. The qualified id is derived here from the
// upstream fields, never read from a stored value.
const upstream = readUpstream(data);
const qualifiedId = upstream ? deriveQualifiedId(upstream) : undefined;
const publisherId = upstream ? normaliseSegment(upstream.publisher.id) : undefined;
const VERSION_SOURCE_LABELS: Record<string, string> = {
  "github-release": "GitHub release",
  "git-tag": "Git tag",
  pypi: "PyPI",
  npm: "npm",
  "huggingface-revision": "Hugging Face revision",
  "model-card": "Model card",
  commit: "Commit",
};
const PUBLISHER_TYPE_LABELS: Record<string, string> = {
  "github-org": "GitHub organisation",
  "github-user": "GitHub user",
  "huggingface-org": "Hugging Face organisation",
  "huggingface-user": "Hugging Face user",
  npm: "npm scope",
  organisation: "Organisation",
  other: "Other",
};
// A 40-character revision hash is unreadable in prose; show a short form and
// keep the full value in the qualified id and the title attribute.
function displayVersion(version: string): string {
  return /^[0-9a-f]{40}$/.test(version) ? version.slice(0, 12) : version;
}

interface Quantisation {
  format: string;
  bits: number;
  publisher: string;
  url: string;
  size_bytes?: number;
}
const modelDetails = type === "models"
  ? (data.model_details as
      | { parameters?: number | string; reference_precision?: string; weights_availability?: string; licence?: string; quantisations?: Quantisation[] }
      | undefined)
  : undefined;
const WEIGHTS_LABELS: Record<string, string> = {
  open: "Open (downloadable without approval)",
  gated: "Gated (download after an access request or licence acceptance)",
  "api-only": "API only (hosted service, no weights download)",
  unreleased: "Unreleased",
};
function formatParameters(value: number | string): string {
  if (typeof value === "string") return value;
  const units: Array<[number, string]> = [[1e12, "T"], [1e9, "B"], [1e6, "M"], [1e3, "K"]];
  for (const [size, unit] of units) {
    if (value >= size) return `${Number((value / size).toFixed(1))}${unit} (${value.toLocaleString("en-GB")})`;
  }
  return value.toLocaleString("en-GB");
}
function formatBytes(bytes: number): string {
  const units = ["B", "KB", "MB", "GB", "TB"];
  let value = bytes;
  let unit = 0;
  while (value >= 1000 && unit < units.length - 1) {
    value /= 1000;
    unit += 1;
  }
  return `${Number(value.toFixed(value >= 10 || unit === 0 ? 0 : 1))} ${units[unit]}`;
}

const actions = deriveEntryActions(type, data, {
  hasInstallPanels: (type === "mcp-servers" ? mcpPanels : pluginPanels).length > 0,
});
---

<Base title={String(data.name)} description={summaryText}>
  <article data-pagefind-body data-pagefind-filter={`type:${meta.type}`}>
    <header class="detail-header">
      <div>
        <p class="breadcrumb">
          <a href={withBase(`/${type}/`)}><Icon name={type} size={16} />{meta.label}</a>
        </p>
        <h1 class="detail-header__title">{String(data.name)}</h1>
        {qualifiedId && (
          <div class="qualified-id">
            <span class="qualified-id__label">Qualified id</span>
            <code id="qualified-id">{qualifiedId}</code>
            <CopyButton targetId="qualified-id" label="Copy qualified id" />
          </div>
        )}
        <p class="page-intro">{summaryText}</p>
      </div>
      <div class="detail-header__aside">
        <div class="detail-badges">
          <CertificationBadge tier={String(data.certification_tier ?? "unsigned")} />
        </div>
        <EntryActions actions={actions} />
      </div>
    </header>

    <section class="detail-section">
      <h2>Overview</h2>
      <div class="markdown-body" set:html={descriptionHtml} />
    </section>

    <section class="detail-section">
      <h2>Details</h2>
      <dl class="field-list">
        <dt>Licence</dt>
        <dd>
          {String(data.license)}
          {data.license === "other" && data.license_url ? (
            <>
              {" "}
              (<a href={String(data.license_url)}>full text</a>)
            </>
          ) : null}
        </dd>
        <dt>Version</dt>
        <dd>{String(data.version)}</dd>
        <dt>Category</dt>
        <dd data-pagefind-filter={`category:${String(data.category ?? "")}`}>
          {categoryLabel(type, String(data.category ?? ""))}
        </dd>
        <dt>Homepage</dt>
        <dd><a href={String(data.homepage)}>{String(data.homepage)}</a></dd>
        <dt>Repository</dt>
        <dd><a href={String(data.repository)}>{String(data.repository)}</a></dd>
        <dt>Maintainers</dt>
        <dd>
          {maintainers.map((m, i) => (
            <>
              {i > 0 ? ", " : ""}
              {m.name} (<a href={`https://github.com/${m.github}`}>@{m.github}</a>
              {m.affiliation ? `, ${m.affiliation}` : ""})
            </>
          ))}
        </dd>
        {
          keywords.length > 0 && (
            <>
              <dt>Keywords</dt>
              <dd>
                {keywords.map((k) => (
                  <span class="badge badge--keyword" data-pagefind-filter={`keyword:${k}`}>
                    {k}
                  </span>
                ))}{" "}
              </dd>
            </>
          )
        }
        {
          standards.length > 0 && (
            <>
              <dt>GA4GH standards</dt>
              <dd>
                {standards.map((s) => (
                  <span class="badge badge--keyword" data-pagefind-filter={`ga4gh_standards:${s}`}>
                    {s}
                  </span>
                ))}{" "}
              </dd>
            </>
          )
        }
      </dl>
    </section>

    {
      upstream && publisherId && (
        <section class="detail-section" aria-labelledby="publisher-heading">
          <h2 id="publisher-heading">Publisher</h2>
          <dl class="field-list">
            <dt>Published by</dt>
            <dd data-pagefind-filter={`publisher:${upstream.publisher.name}`}>
              <a href={withBase(`/publishers/${publisherId}/`)}>{upstream.publisher.name}</a>
              {" "}
              <span class="field-note">({PUBLISHER_TYPE_LABELS[upstream.publisher.type] ?? upstream.publisher.type})</span>
              {upstream.publisher.url && (
                <>
                  {" "}
                  <a href={upstream.publisher.url}>profile ↗</a>
                </>
              )}
            </dd>
            <dt>Upstream name</dt>
            <dd>{upstream.name}</dd>
            <dt>Upstream version</dt>
            <dd>
              {upstream.version ? (
                <>
                  <code title={upstream.version}>{displayVersion(upstream.version)}</code>
                  {upstream.version_source && (
                    <span class="field-note"> ({VERSION_SOURCE_LABELS[upstream.version_source] ?? upstream.version_source})</span>
                  )}
                </>
              ) : (
                "No version published upstream"
              )}
            </dd>
            {upstream.version_date && (
              <>
                <dt>Version date</dt>
                <dd><time datetime={formatDate(upstream.version_date).iso}>{formatDate(upstream.version_date).label}</time></dd>
              </>
            )}
          </dl>
        </section>
      )
    }

    <section class="detail-section" aria-labelledby="safety-heading">
      <h2 id="safety-heading">Safety classification</h2>
      <SafetyBadges classifications={safety} />
      <p class="field-note">
        <a href={withBase("/safety-levels/")}>What the safety levels mean</a>
      </p>
    </section>

    {
      type === "models" && (
        <section class="detail-section">
          <h2>Model Card</h2>
          <p>
            <a href={String(data.model_card_uri)}>View the upstream model card ↗</a>
          </p>
          <dl class="field-list">
            {data.pipeline_tag && (
              <>
                <dt>Pipeline tag</dt>
                <dd>{String(data.pipeline_tag)}</dd>
              </>
            )}
            {data.hosting_location && (
              <>
                <dt>Hosting</dt>
                <dd>{String(data.hosting_location)}</dd>
              </>
            )}
            {data.access_uri && (
              <>
                <dt>Access</dt>
                <dd>
                  <a href={String(data.access_uri)}>{String(data.access_uri)}</a>
                </dd>
              </>
            )}
            {data.install_command && (
              <>
                <dt>Install</dt>
                <dd>
                  <div class="install-snippet-row" id="model-install">
                    <pre id="model-install-command">{String(data.install_command)}</pre>
                    <CopyButton targetId="model-install-command" label="Copy install command" />
                  </div>
                </dd>
              </>
            )}
          </dl>
          {modelDetails && (
            <>
              <h3 id="model-details-heading">Model details</h3>
              <dl class="field-list" aria-labelledby="model-details-heading">
                {modelDetails.parameters !== undefined && (
                  <>
                    <dt>Parameters</dt>
                    <dd>{formatParameters(modelDetails.parameters)}</dd>
                  </>
                )}
                {modelDetails.reference_precision && (
                  <>
                    <dt>Reference precision</dt>
                    <dd><code>{modelDetails.reference_precision}</code></dd>
                  </>
                )}
                {modelDetails.weights_availability && (
                  <>
                    <dt>Weights</dt>
                    <dd>{WEIGHTS_LABELS[modelDetails.weights_availability] ?? modelDetails.weights_availability}</dd>
                  </>
                )}
                {modelDetails.licence && (
                  <>
                    <dt>Weights licence</dt>
                    <dd>{modelDetails.licence === "other" ? "Custom terms (see the licence link above)" : modelDetails.licence}</dd>
                  </>
                )}
              </dl>
              {modelDetails.quantisations && modelDetails.quantisations.length > 0 && (
                <div class="table-scroll" role="region" aria-labelledby="quantisations-caption" tabindex="0">
                  <table class="data-table">
                    <caption id="quantisations-caption">Quantised variants</caption>
                    <thead>
                      <tr>
                        <th scope="col">Format</th>
                        <th scope="col">Bits</th>
                        <th scope="col">Publisher</th>
                        <th scope="col">Size</th>
                        <th scope="col">Link</th>
                      </tr>
                    </thead>
                    <tbody>
                      {modelDetails.quantisations.map((q) => (
                        <tr>
                          <td><code>{q.format}</code></td>
                          <td>{q.bits}</td>
                          <td>{q.publisher === "official" ? "Official" : q.publisher}</td>
                          <td>{q.size_bytes !== undefined ? formatBytes(q.size_bytes) : "Not stated"}</td>
                          <td><a href={q.url}>Download page<span class="visually-hidden"> for the {q.format} {q.bits}-bit variant</span> ↗</a></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </>
          )}
          {data.last_synced && (
            <p class="cache-note">
              Mirrored data last synced from the Model Card at {String(data.last_synced)}. See the linked card for
              the authoritative, live version.
            </p>
          )}
        </section>
      )
    }

    {
      type === "agents" && (
        <section class="detail-section">
          <h2>Agent info snapshot</h2>
          <p>
            <a href={String(data.agent_info_uri)}>View the live Agent Info endpoint ↗</a>
          </p>
          {(() => {
            const snapshot = (data.agent_info_snapshot as Record<string, unknown>) ?? {};
            const enrichment = (snapshot.enrichment as Record<string, unknown>) ?? {};
            return (
              <>
                <dl class="field-list">
                  {snapshot.protocol_version && (
                    <>
                      <dt>Protocol version</dt>
                      <dd>{String(snapshot.protocol_version)}</dd>
                    </>
                  )}
                  {snapshot.agent_type && (
                    <>
                      <dt>Agent type</dt>
                      <dd>{String(snapshot.agent_type)}</dd>
                    </>
                  )}
                  {snapshot.trust_level && (
                    <>
                      <dt>Trust level</dt>
                      <dd>{String(snapshot.trust_level)}</dd>
                    </>
                  )}
                  {enrichment.trust_score !== undefined && (
                    <>
                      <dt>Trust score</dt>
                      <dd>{String(enrichment.trust_score)} / 1000</dd>
                    </>
                  )}
                  {enrichment.trust_tier && (
                    <>
                      <dt>Trust tier</dt>
                      <dd>{String(enrichment.trust_tier)}</dd>
                    </>
                  )}
                  {enrichment.gasl_level !== undefined && (
                    <>
                      <dt>{SAFETY_DISPLAY["ga4gh-agent-runtime-risk"]?.label ?? "Runtime risk tier"} (live sync)</dt>
                      <dd>
                        <a href={withBase(`/safety-levels/#${safetyLevelAnchor("ga4gh-agent-runtime-risk", String(enrichment.gasl_level))}`)}>
                          {String(enrichment.gasl_level)}
                        </a>
                      </dd>
                    </>
                  )}
                  {data.alignment_card_uri && (
                    <>
                      <dt>Alignment card</dt>
                      <dd>
                        <a href={String(data.alignment_card_uri)}>{String(data.alignment_card_uri)}</a>
                      </dd>
                    </>
                  )}
                </dl>
                {snapshot.last_synced && (
                  <p class="cache-note">
                    This is a cached snapshot of the agent's live endpoint, last synced at {String(snapshot.last_synced)}.
                    It is not live status; see the linked endpoint for current values.
                  </p>
                )}
              </>
            );
          })()}
        </section>
      )
    }

    {
      type === "skills" && (
        <section class="detail-section">
          <h2>Skill</h2>
          {(() => {
            const skill = (data.skill as Record<string, unknown>) ?? {};
            const source = (data.source as { repository?: { url?: string; subfolder?: string } }) ?? {};
            const inputs = (data.inputs as Array<{ name: string; type: string; description?: string }>) ?? [];
            const outputs = (data.outputs as Array<{ name: string; type: string; description?: string }>) ?? [];
            return (
              <>
                <dl class="field-list">
                  <dt>Human oversight</dt>
                  <dd>{String(data.human_oversight)}</dd>
                  <dt>Provenance logging</dt>
                  <dd>{data.provenance_logging ? "Yes" : "No"}</dd>
                  {data.evaluation_criteria_uri && (
                    <>
                      <dt>Evaluation criteria</dt>
                      <dd>
                        <a href={String(data.evaluation_criteria_uri)}>{String(data.evaluation_criteria_uri)}</a>
                      </dd>
                    </>
                  )}
                  {source.repository?.url && (
                    <>
                      <dt>Source</dt>
                      <dd>
                        <a href={source.repository.url}>{source.repository.url}</a>
                        {source.repository.subfolder ? ` (${source.repository.subfolder})` : ""}
                      </dd>
                    </>
                  )}
                </dl>
                {inputs.length > 0 && (
                  <>
                    <h3>Inputs</h3>
                    <ul>
                      {inputs.map((i) => (
                        <li>
                          <strong>{i.name}</strong> ({i.type}){i.description ? ` — ${i.description}` : ""}
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                {outputs.length > 0 && (
                  <>
                    <h3>Outputs</h3>
                    <ul>
                      {outputs.map((o) => (
                        <li>
                          <strong>{o.name}</strong> ({o.type}){o.description ? ` — ${o.description}` : ""}
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </>
            );
          })()}
        </section>
      )
    }

    {
      type === "mcp-servers" && (
        <section class="detail-section">
          <h2>Server manifest</h2>
          {(() => {
            const server = (data.server as Record<string, unknown>) ?? {};
            const metaBlock = ((server._meta as Record<string, unknown> | undefined)?.["org.ga4gh/ai-registry"] as
              | { ga4gh_standards?: string[] }
              | undefined) ?? {};
            return (
              <dl class="field-list">
                <dt>Server name</dt>
                <dd>{String(server.name ?? "")}</dd>
                {server.version && (
                  <>
                    <dt>Server version</dt>
                    <dd>{String(server.version)}</dd>
                  </>
                )}
                {metaBlock.ga4gh_standards && metaBlock.ga4gh_standards.length > 0 && (
                  <>
                    <dt>Implements</dt>
                    <dd>{metaBlock.ga4gh_standards.join(", ")}</dd>
                  </>
                )}
              </dl>
            );
          })()}
        </section>
      )
    }

    {
      type === "bundles" && (
        <section class="detail-section">
          <h2>Marketplace</h2>
          {(() => {
            const marketplace = (data.marketplace as Record<string, unknown>) ?? {};
            const owner = (marketplace.owner as { name?: string; url?: string } | undefined) ?? {};
            const plugins = (marketplace.plugins as Array<{ name: string; description?: string; source?: unknown }>) ?? [];
            const members = ((data.ga4gh as { members?: Array<{ type: string; id: string }> } | undefined)?.members) ?? [];
            return (
              <>
                <dl class="field-list">
                  {marketplace.name && (
                    <>
                      <dt>Marketplace name</dt>
                      <dd>{String(marketplace.name)}</dd>
                    </>
                  )}
                  {owner.name && (
                    <>
                      <dt>Curated by</dt>
                      <dd>{owner.url ? <a href={owner.url}>{owner.name}</a> : owner.name}</dd>
                    </>
                  )}
                  <dt>Plugins in this bundle</dt>
                  <dd>{plugins.length}</dd>
                  {data.source_uri && (
                    <>
                      <dt>Source</dt>
                      <dd>
                        <a href={String(data.source_uri)}>{String(data.source_uri)}</a>
                      </dd>
                    </>
                  )}
                </dl>
                {plugins.length > 0 && (
                  <>
                    <h3>Bundled plugins</h3>
                    <ul>
                      {plugins.map((p) => {
                        const linkedMember = members.find((m) => m.type === "plugin" && m.id === p.name);
                        return (
                          <li>
                            <strong>{p.name}</strong>
                            {p.description ? ` — ${p.description}` : ""}
                            {linkedMember && (
                              <>
                                {" "}
                                (<a href={withBase(`/plugins/${linkedMember.id}/`)}>also catalogued in this registry ↗</a>)
                              </>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  </>
                )}
                {data.last_synced && (
                  <p class="cache-note">
                    This is a cached snapshot of the marketplace manifest at {String(data.source_uri)}, last synced
                    at {String(data.last_synced)}. See the source for the authoritative, live listing.
                  </p>
                )}
              </>
            );
          })()}
        </section>
      )
    }

    {
      (type === "mcp-servers" || type === "plugins") && (
        <section class="detail-section" id="install">
          <h2>Install</h2>
          <InstallTabs heading={`Install ${String(data.name)}`} panels={type === "mcp-servers" ? mcpPanels : pluginPanels} />
        </section>
      )
    }

    <section class="detail-section">
      <h2>Provenance</h2>
      <dl class="field-list">
        {record.created && (
          <>
            <dt>Created</dt>
            <dd><time datetime={formatDate(record.created).iso}>{formatDate(record.created).label}</time></dd>
          </>
        )}
        {record.updated && (
          <>
            <dt>Updated</dt>
            <dd><time datetime={formatDate(record.updated).iso}>{formatDate(record.updated).label}</time></dd>
          </>
        )}
        {record.last_verified && (
          <>
            <dt>Last verified</dt>
            <dd><time datetime={formatDate(record.last_verified).iso}>{formatDate(record.last_verified).label}</time></dd>
          </>
        )}
        {record.source_issue !== undefined && (
          <>
            <dt>Submission issue</dt>
            <dd>#{record.source_issue}</dd>
          </>
        )}
      </dl>
    </section>
  </article>
</Base>
